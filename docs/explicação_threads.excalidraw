      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1608784567,
      "version": 817,
      "versionNonce": 843721433,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792631047132,
      "link": null,
      "locked": false,
      "text": "Prompt da IA:\nQuero que a identificação das possíveis trajetórias (comandos)\nseja feita, sempre que possível, sem o uso de LLMs.\nPrimeiramente, ela deve tentar fazer predições com NLU e TF-\nIDF e regressão logística para identificar se aquele prompt do\nusuário pertence ou não a uma classe\n(trajetório/comando/função em python). Se ele não conseguir,\naí sim ele usará a LLM. Use Regex o máximo possível para\nidentificar termos relacionados a horários ex: meio-dia, meia-\nnoite, e todos os algarismos por extenso ex: treze, vinte e\ndois, quarenta e cinco. Ele não deve ser muito rígido, mas\ntambém não deve ser excessivamente flexível. Use paralelismo\npara a predição das classes. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prompt da IA:\nQuero que a identificação das possíveis trajetórias (comandos) seja feita, sempre que possível, sem o uso de LLMs. Primeiramente, ela deve tentar fazer predições com NLU e TF-IDF e regressão logística para identificar se aquele prompt do usuário pertence ou não a uma classe (trajetório/comando/função em python). Se ele não conseguir, aí sim ele usará a LLM. Use Regex o máximo possível para identificar termos relacionados a horários ex: meio-dia, meia-noite, e todos os algarismos por extenso ex: treze, vinte e dois, quarenta e cinco. Ele não deve ser muito rígido, mas também não deve ser excessivamente flexível. Use paralelismo para a predição das classes. ",
      "autoResize": false,
      "lineHeight": 1.25
    }
