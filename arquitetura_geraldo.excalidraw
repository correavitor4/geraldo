    {
      "id": "text_8_1792287961",
      "type": "text",
      "x": 125,
      "y": 270,
      "width": 407,
      "height": 84,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
