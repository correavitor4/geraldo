{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geraldo",
  "version": "0.1.0",
  "identifier": "com.geraldo.desktop",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Geraldo - Assistente de Voz",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "tooltip": "Geraldo - Assistente de Voz",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/geraldo-core"
    ],
    "copyright": "Copyright © 2026 Geraldo AI",
    "category": "Productivity",
    "shortDescription": "Assistente de voz desktop inteligente e local",
    "longDescription": "Geraldo é um assistente de voz desktop inteligente, rápido e direto com processamento neural local e barramento IPC.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Portuguese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": null,
        "windowPosition": {
          "x": 400,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
