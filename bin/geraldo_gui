#!/usr/bin/env bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# 1. Garante que o servico geraldo.service esteja rodando se disponivel
if command -v systemctl >/dev/null 2>&1; then
    if ! systemctl --user is-active --quiet geraldo.service; then
        systemctl --user start geraldo.service || true
    fi
fi

# macOS App Bundle instalado
if [ -d "/Applications/Geraldo.app" ]; then
    open "/Applications/Geraldo.app"
    exit 0
fi


# 2. Executavel nativo Tauri local ou no sistema
if [ -f "$DIR/../src-tauri/target/debug/geraldo-desktop" ] && [ -x "$DIR/../src-tauri/target/debug/geraldo-desktop" ]; then
    exec "$DIR/../src-tauri/target/debug/geraldo-desktop" "$@"
fi

if [ -f "$DIR/../src-tauri/target/release/geraldo-desktop" ] && [ -x "$DIR/../src-tauri/target/release/geraldo-desktop" ]; then
    exec "$DIR/../src-tauri/target/release/geraldo-desktop" "$@"
fi

if [ -f "/usr/bin/geraldo-desktop" ]; then
    exec "/usr/bin/geraldo-desktop" "$@"
fi

if [ -f "$DIR/geraldo-desktop" ]; then
    exec "$DIR/geraldo-desktop" "$@"
fi

# 3. Fallback no repositorio / desenvolvimento com venv
if [ -f "$DIR/../venv/bin/python" ]; then
    exec "$DIR/../venv/bin/python" "$DIR/../ui/gui.py" "$@"
fi

if [ -f "$DIR/venv/bin/python" ]; then
    exec "$DIR/venv/bin/python" "$DIR/ui/gui.py" "$@"
fi

exec python3 -m ui.gui "$@"
