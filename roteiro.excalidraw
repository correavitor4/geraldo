    {
      "id": "text_1792392127407_4036499189401910541",
      "type": "text",
      "x": 90,
      "y": 248,
      "width": 1620,
      "height": 110,
      "angle": 0,
      "strokeColor": "#f8fafc",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
