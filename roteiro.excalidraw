    {
      "id": "text_1792392127407_1603166424278488009",
      "type": "text",
      "x": 90,
      "y": 468,
      "width": 1620,
      "height": 110,
      "angle": 0,
      "strokeColor": "#f8fafc",
      "backgroundColor": "transparent",
